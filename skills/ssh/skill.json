{
    "id": "ssh",
    "displayName": "SSH Client",
    "description": "Connect to remote servers via SSH. Supports both sequential command execution and persistent bridge sessions.",
    "networkMode": "host",
    "actions": [
        {
            "name": "ssh_run",
            "description": "Establish an SSH connection and execute a list of commands sequentially (one-shot).",
            "parameters": {
                "type": "object",
                "properties": {
                    "host": {
                        "type": "string",
                        "description": "Remote host address (e.g., 100.81.109.108)"
                    },
                    "user": {
                        "type": "string",
                        "description": "SSH username"
                    },
                    "port": {
                        "type": "integer",
                        "description": "SSH port",
                        "default": 22
                    },
                    "commands": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "List of commands to execute sequentially."
                    },
                    "cleanup_commands": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Commands to execute at the end."
                    },
                    "ignoreFail": {
                        "type": "boolean",
                        "description": "If true, continues even if a command fails.",
                        "default": false
                    }
                },
                "required": [
                    "host",
                    "user"
                ]
            },
            "_script": "ssh_run.sh",
            "dockerImage": "kroniak/ssh-client",
            "entrypoint": [
                "sh"
            ]
        },
        {
            "name": "ssh_connect",
            "description": "Establish a persistent SSH bridge. Best used for background/interactive sessions.",
            "parameters": {
                "type": "object",
                "properties": {
                    "host": {
                        "type": "string",
                        "description": "Remote host address"
                    },
                    "user": {
                        "type": "string",
                        "description": "SSH username"
                    },
                    "port": {
                        "type": "integer",
                        "description": "SSH port",
                        "default": 22
                    }
                },
                "required": [
                    "host",
                    "user"
                ]
            },
            "_script": "ssh_connect.sh",
            "dockerImage": "kroniak/ssh-client",
            "tty": true,
            "onlyBg": true,
            "entrypoint": [
                "sh"
            ]
        }
    ]
}