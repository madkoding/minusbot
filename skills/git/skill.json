{
    "id": "git",
    "displayName": "Git Version Control",
    "description": "Powerful Git operations using alpine/git container. Protects your credentials via vault secrets.",
    "vaultKeys": [
        "PERSONAL_TOKEN"
    ],
    "dockerImage": "alpine/git:latest",
    "enableNetwork": true,
    "configSchema": {
        "type": "object",
        "properties": {
            "user_name": {
                "type": "string",
                "description": "The name to use for git commits (user.name)"
            },
            "user_email": {
                "type": "string",
                "description": "The email to use for git commits (user.email)"
            }
        }
    },
    "actions": [
        {
            "name": "raw",
            "description": "Execute any raw git command.",
            "parameters": {
                "type": "object",
                "properties": {
                    "args": {
                        "type": "string",
                        "description": "The command line arguments for git (e.g. 'status', 'log -n 5')"
                    }
                },
                "required": [
                    "args"
                ]
            },
            "_script": "git_handler.sh"
        },
        {
            "name": "clone",
            "description": "Clone a repository into a directory.",
            "parameters": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "description": "The URL of the repository to clone."
                    },
                    "directory": {
                        "type": "string",
                        "description": "Optional directory name to clone into."
                    }
                },
                "required": [
                    "url"
                ]
            },
            "_script": "git_handler.sh"
        },
        {
            "name": "commit",
            "description": "Record changes to the repository.",
            "parameters": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "description": "The commit message."
                    },
                    "all": {
                        "type": "boolean",
                        "description": "Tell the command to automatically stage files that have been modified and deleted, but new files you have not told Git about are not affected.",
                        "default": true
                    }
                },
                "required": [
                    "message"
                ]
            },
            "_script": "git_handler.sh"
        },
        {
            "name": "push",
            "description": "Update remote refs along with associated objects.",
            "parameters": {
                "type": "object",
                "properties": {
                    "remote": {
                        "type": "string",
                        "description": "The 'remote' repository that is the destination of the push operation.",
                        "default": "origin"
                    },
                    "branch": {
                        "type": "string",
                        "description": "The branch to push.",
                        "default": "main"
                    }
                }
            },
            "_script": "git_handler.sh"
        },
        {
            "name": "pull",
            "description": "Fetch from and integrate with another repository or a local branch.",
            "parameters": {
                "type": "object",
                "properties": {
                    "remote": {
                        "type": "string",
                        "description": "The 'remote' repository that is the source of the pull operation.",
                        "default": "origin"
                    },
                    "branch": {
                        "type": "string",
                        "description": "The branch to pull.",
                        "default": "main"
                    }
                }
            },
            "_script": "git_handler.sh"
        },
        {
            "name": "add",
            "description": "Add file contents to the index.",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "description": "File or directory to add. Use '.' for all.",
                        "default": "."
                    }
                },
                "required": [
                    "path"
                ]
            },
            "_script": "git_handler.sh"
        },
        {
            "name": "status",
            "description": "Show the working tree status.",
            "parameters": {
                "type": "object",
                "properties": {}
            },
            "_script": "git_handler.sh"
        }
    ]
}