{
    "id": "converter",
    "displayName": "File Converter",
    "description": "Convert images and documents between various formats using specialized tools.",
    "actions": [
        {
            "name": "image",
            "description": "Convert or process an image (formats: jpg, png, webp, gif, etc.)",
            "parameters": {
                "type": "object",
                "properties": {
                    "input": {
                        "type": "string",
                        "description": "Input filename"
                    },
                    "output": {
                        "type": "string",
                        "description": "Output filename"
                    },
                    "options": {
                        "type": "string",
                        "description": "Arguments for magick (e.g. '-resize 50%')"
                    }
                },
                "required": [
                    "input",
                    "output"
                ]
            },
            "_script": "image.sh",
            "dockerImage": "dpokidov/imagemagick:latest",
            "entrypoint": [
                "sh"
            ]
        },
        {
            "name": "document",
            "description": "Convert documents (pdf, docx, html, epub, etc.)",
            "parameters": {
                "type": "object",
                "properties": {
                    "input": {
                        "type": "string",
                        "description": "Input filename"
                    },
                    "output": {
                        "type": "string",
                        "description": "Output filename"
                    },
                    "options": {
                        "type": "string",
                        "description": "Pandoc options (e.g. '--toc')"
                    }
                },
                "required": [
                    "input",
                    "output"
                ]
            },
            "_script": "document.sh",
            "dockerImage": "pandoc/latex:latest",
            "entrypoint": [
                "sh"
            ]
        },
        {
            "name": "images_to_pdf",
            "description": "Combine multiple images into a single PDF document.",
            "parameters": {
                "type": "object",
                "properties": {
                    "images": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "List of image paths in order."
                    },
                    "output": {
                        "type": "string",
                        "description": "Path to the resulting PDF."
                    }
                },
                "required": [
                    "images",
                    "output"
                ]
            },
            "_script": "images_to_pdf.sh",
            "dockerImage": "dpokidov/imagemagick:latest",
            "entrypoint": [
                "sh"
            ]
        }
    ]
}