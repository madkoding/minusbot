{
    "id": "serpapi",
    "displayName": "SerpApi Search",
    "description": "Perform Google searches and get organic results using SerpApi.",
    "vaultKeys": [
        "API_KEY"
    ],
    "requiredVaultKeys": [
        "API_KEY"
    ],
    "enableNetwork": true,
    "configSchema": {
        "type": "object",
        "properties": {
            "engine": {
                "type": "string",
                "description": "Search engine to use (default: google)",
                "default": "google"
            },
            "location": {
                "type": "string",
                "description": "Location for search results (e.g. Austin, Texas)"
            },
            "google_domain": {
                "type": "string",
                "description": "Google domain to use (default: google.com)",
                "default": "google.com"
            },
            "gl": {
                "type": "string",
                "description": "Country code (e.g. us, uk)",
                "default": "us"
            },
            "hl": {
                "type": "string",
                "description": "Language Code (e.g. en, es)",
                "default": "en"
            }
        }
    },
    "actions": [
        {
            "name": "search",
            "description": "Search the web for information using Google.",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "The search query"
                    }
                },
                "required": [
                    "query"
                ]
            },
            "_script": "search.py"
        }
    ]
}