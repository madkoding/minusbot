{
    "id": "ffmpeg",
    "displayName": "FFmpeg Video Suite",
    "description": "Universal FFmpeg and FFprobe access. Use this to run any video/audio processing command.",
    "vaultKeys": [],
    "configSchema": {},
    "bins": [
        {
            "name": "ffmpeg",
            "urls": {
                "linux-x64": "https://github.com/ffbinaries/ffbinaries-prebuilt/releases/download/v4.4.1/ffmpeg-4.4.1-linux-64.zip",
                "linux-arm64": "https://github.com/ffbinaries/ffbinaries-prebuilt/releases/download/v4.4.1/ffmpeg-4.4.1-linux-arm-64.zip"
            },
            "actions": [
                "ffmpeg"
            ]
        },
        {
            "name": "ffprobe",
            "urls": {
                "linux-x64": "https://github.com/ffbinaries/ffbinaries-prebuilt/releases/download/v4.4.1/ffprobe-4.4.1-linux-64.zip",
                "linux-arm64": "https://github.com/ffbinaries/ffbinaries-prebuilt/releases/download/v4.4.1/ffprobe-4.4.1-linux-arm-64.zip"
            },
            "actions": [
                "ffprobe"
            ]
        }
    ],
    "actions": [
        {
            "name": "ffmpeg",
            "description": "Execute a raw ffmpeg command. Specify the input files, filters, and output file as you would in the terminal.",
            "parameters": {
                "type": "object",
                "properties": {
                    "args": {
                        "type": "string",
                        "description": "The command line arguments for ffmpeg (e.g. '-i input.mp4 -vf scale=1280:-1 output.mp4')"
                    }
                },
                "required": [
                    "args"
                ]
            },
            "_script": "ffmpeg.py"
        },
        {
            "name": "ffprobe",
            "description": "Execute a raw ffprobe command to extract information from media files.",
            "parameters": {
                "type": "object",
                "properties": {
                    "args": {
                        "type": "string",
                        "description": "The command line arguments for ffprobe (e.g. '-v error -show_format -show_streams -print_format json input.mp4')"
                    }
                },
                "required": [
                    "args"
                ]
            },
            "_script": "ffprobe.py"
        }
    ]
}