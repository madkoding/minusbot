{
    "id": "chromecast",
    "displayName": "Chromecast",
    "description": "Control your Chromecast devices for media playback and discovery.",
    "dockerImage": "custom",
    "networkMode": "host",
    "enableNetwork": true,
    "actions": [
        {
            "name": "discover",
            "description": "Scan the local network for available Chromecast devices.",
            "parameters": {
                "type": "object",
                "properties": {
                    "timeout": {
                        "type": "number",
                        "description": "Scan duration in seconds.",
                        "default": 5
                    }
                }
            },
            "_script": "discover.py"
        },
        {
            "name": "save_favorite",
            "description": "Save a Chromecast device as your favorite default.",
            "parameters": {
                "type": "object",
                "properties": {
                    "friendly_name": {
                        "type": "string",
                        "description": "The friendly name of the device."
                    }
                },
                "required": [
                    "friendly_name"
                ]
            },
            "_script": "save_favorite.py"
        },
        {
            "name": "list_saved",
            "description": "Show your saved Chromecast devices.",
            "parameters": {
                "type": "object",
                "properties": {}
            },
            "_script": "list_saved.py"
        },
        {
            "name": "cast",
            "description": "Play a media URL on a specific Chromecast device.",
            "parameters": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "description": "Media URL to play."
                    },
                    "content_type": {
                        "type": "string",
                        "description": "MIME type (e.g. video/mp4).",
                        "default": "video/mp4"
                    },
                    "device_name": {
                        "type": "string",
                        "description": "Friendly name of the device. If not provided, uses the saved favorite."
                    }
                },
                "required": [
                    "url"
                ]
            },
            "_script": "cast.py"
        }
    ]
}