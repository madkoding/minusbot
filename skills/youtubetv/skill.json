{
    "id": "youtubetv",
    "description": "Control YouTube on Smart TVs and Chromecasts via DIAL protocol.",
    "dockerImage": "custom",
    "networkMode": "host",
    "enableNetwork": true,
    "actions": [
        {
            "name": "discover",
            "description": "Scan the local network for available DIAL devices (TVs, Chromecasts).",
            "parameters": {
                "type": "object",
                "properties": {
                    "timeout": {
                        "type": "number",
                        "description": "Scan duration in seconds.",
                        "default": 5
                    }
                }
            },
            "_script": "wrapper.py",
            "args": {
                "mode": "discover"
            }
        },
        {
            "name": "save_favorite",
            "description": "Save a device as a favorite for quick access.",
            "parameters": {
                "type": "object",
                "properties": {
                    "friendly_name": {
                        "type": "string",
                        "description": "A friendly name to identify the device."
                    },
                    "ip": {
                        "type": "string",
                        "description": "The IP address of the device."
                    },
                    "port": {
                        "type": "number",
                        "description": "The DIAL port (default 8008)."
                    }
                },
                "required": [
                    "friendly_name",
                    "ip"
                ]
            },
            "_script": "wrapper.py",
            "args": {
                "mode": "save"
            }
        },
        {
            "name": "list_saved",
            "description": "List all saved favorite devices.",
            "parameters": {
                "type": "object",
                "properties": {}
            },
            "_script": "wrapper.py",
            "args": {
                "mode": "list"
            }
        },
        {
            "name": "play_video",
            "description": "Play a specific YouTube video on a device.",
            "parameters": {
                "type": "object",
                "properties": {
                    "video_id": {
                        "type": "string",
                        "description": "The YouTube video ID."
                    },
                    "playlist_id": {
                        "type": "string",
                        "description": "Optional playlist ID to start from."
                    },
                    "device": {
                        "type": "string",
                        "description": "Device name or IP. Defaults to first favorite."
                    },
                    "port": {
                        "type": "number",
                        "description": "Optional port override if using IP."
                    }
                },
                "required": [
                    "video_id"
                ]
            },
            "_script": "wrapper.py",
            "args": {
                "mode": "control",
                "action": "play_video"
            }
        },
        {
            "name": "play_playlist",
            "description": "Play a YouTube playlist on a device.",
            "parameters": {
                "type": "object",
                "properties": {
                    "playlist_id": {
                        "type": "string",
                        "description": "The YouTube playlist ID."
                    },
                    "device": {
                        "type": "string",
                        "description": "Device name or IP. Defaults to first favorite."
                    },
                    "port": {
                        "type": "number",
                        "description": "Optional port override if using IP."
                    }
                },
                "required": [
                    "playlist_id"
                ]
            },
            "_script": "wrapper.py",
            "args": {
                "mode": "control",
                "action": "play_playlist"
            }
        },
        {
            "name": "search",
            "description": "Search for a query on YouTube TV app.",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "The search query."
                    },
                    "device": {
                        "type": "string",
                        "description": "Device name or IP. Defaults to first favorite."
                    },
                    "port": {
                        "type": "number",
                        "description": "Optional port override if using IP."
                    }
                },
                "required": [
                    "query"
                ]
            },
            "_script": "wrapper.py",
            "args": {
                "mode": "control",
                "action": "search"
            }
        },
        {
            "name": "open_channel",
            "description": "Open a YouTube channel on a device.",
            "parameters": {
                "type": "object",
                "properties": {
                    "channel_id": {
                        "type": "string",
                        "description": "The YouTube channel ID."
                    },
                    "device": {
                        "type": "string",
                        "description": "Device name or IP. Defaults to first favorite."
                    },
                    "port": {
                        "type": "number",
                        "description": "Optional port override if using IP."
                    }
                },
                "required": [
                    "channel_id"
                ]
            },
            "_script": "wrapper.py",
            "args": {
                "mode": "control",
                "action": "channel"
            }
        },
        {
            "name": "stop",
            "description": "Stop playback on a device.",
            "parameters": {
                "type": "object",
                "properties": {
                    "device": {
                        "type": "string",
                        "description": "Device name or IP. Defaults to first favorite."
                    },
                    "port": {
                        "type": "number",
                        "description": "Optional port override if using IP."
                    }
                }
            },
            "_script": "wrapper.py",
            "args": {
                "mode": "control",
                "action": "stop"
            }
        },
        {
            "name": "status",
            "description": "Get the current status of the YouTube app on a device.",
            "parameters": {
                "type": "object",
                "properties": {
                    "device": {
                        "type": "string",
                        "description": "Device name or IP. Defaults to first favorite."
                    },
                    "port": {
                        "type": "number",
                        "description": "Optional port override if using IP."
                    }
                }
            },
            "_script": "wrapper.py",
            "args": {
                "mode": "control",
                "action": "status"
            }
        }
    ]
}